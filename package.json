{
  "name": "tauri-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "demo": "vite --config vite.demo.config.ts --open /demo.html",
    "demo:build": "tsc && vite build --config vite.demo.config.ts && node scripts/package-demo.mjs",
    "demo:preview": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 1432 --strictPort",
    "test": "node --test tests/*.test.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "ui:preview": "node scripts/ui-preview.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
